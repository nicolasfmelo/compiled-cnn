{
  "version": 6,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release (all runners whose dependencies are found)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "tsan",
      "displayName": "Own engine only, ThreadSanitizer",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CNN_AOTI": "OFF", "CNN_TRT": "OFF", "CNN_NCNN": "OFF", "CNN_ENGINE": "ON",
        "ENGINE_TSAN": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "tsan", "configurePreset": "tsan", "targets": ["test_kernels", "test_int8", "test_thread_pool"] }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "tsan", "configurePreset": "tsan", "output": { "outputOnFailure": true } }
  ]
}
